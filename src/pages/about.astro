---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Hola, soy Gaby — desarrolladora front-end con 8 años de experiencia y muchas ganas de seguir aprendiendo.",
	title: "About — Gaby Guzman",
};
---

<PageLayout meta={meta}>
	<div class="mb-6 flex items-center justify-between">
		<h1 class="title">Hola, soy Gaby 👋</h1>
		<button
			id="lang-toggle"
			class="rounded-md border border-accent/40 px-3 py-1 text-xs text-accent transition-colors hover:bg-accent/10"
		>
			Switch to English
		</button>
	</div>

	<div class="prose prose-sm prose-cactus max-w-none">

		<!-- ESPAÑOL -->
		<div id="content-es">
			<p>
				Ingeniera front-end senior con más de 8 años de experiencia construyendo aplicaciones web con React, TypeScript y Next.js, principalmente en proyectos de finanzas y retail.
			</p>
			<p>
				Actualmente amplío mi perfil hacia backend con Node.js. También integro agentes de IA en mi flujo de trabajo diario, trabajo principalmente con Claude Code y GitHub Copilot.
			</p>
			<p>
				En este blog escribo sobre decisiones técnicas, refactoring y pruebas. También documento públicamente cómo aprendo sobre modelos de lenguaje (LLMs) y agentes de IA.
			</p>
			<p> Disponible para trabajo remoto / freelance </p>
		</div>

		<!-- ENGLISH -->
		<div id="content-en" class="hidden" lang="es" >
			<p>
			I'm a Senior Frontend Engineer with more than 8 years of experience building web applications with React, TypeScript and Next.js, mainly in finance and retail projects.
			</p>
			<p>
			Currently, I'm expanding my profile toward backend development with Node.js. I also integrate AI agents into my daily workflow. I mainly work with Claude Code and GitHub Copilot.
			</p>
			<p>
				On this blog, I write about technical decisions, refactoring and testing. I also document publicly how I learn about large language models (LLMs) and AI agents.
			</p>
			<strong> Open to remote opportunities / freelance </strong>
		</div>

		<hr class="my-8" />

		<!-- STACK -->
		<h2 class="text-base font-medium mb-3">Stack</h2>
		<div class="flex flex-wrap gap-2 not-prose">
			{["React", "TypeScript", "Next.js", "GraphQL", "Vite",, "React Testing Library", "LitElement", "GCP", "AWS", "GitHub Copilot", "Claude Code", "Node", "MFE", "Tailwind CSS"].map((tech) => (
				<span class="rounded-md border border-accent/40 px-2 py-1 text-xs text-accent">
					{tech}
				</span>
			))}
		</div>

		<hr class="my-8" />

		<!-- LOCATION -->
		<p class="text-sm">
			📍 Puebla, México.
		</p>

		<!-- LINKS -->
		<p class="text-sm">
			<a href="mailto:guzmanhgaby@gmail.com" class="cactus-link">guzmanhgaby@gmail.com</a>
		</p>

	</div>
</PageLayout>

<script>
	const btn = document.getElementById("lang-toggle");
	const es = document.getElementById("content-es");
	const en = document.getElementById("content-en");

	btn?.addEventListener("click", () => {
		const isEs = !es?.classList.contains("hidden");
		es?.classList.toggle("hidden", isEs);
		en?.classList.toggle("hidden", !isEs);
		if (btn) btn.textContent = isEs ? "Cambiar a español" : "Switch to English";
	});
</script>